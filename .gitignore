/target

# macOS
.DS_Store

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Build artifacts
*.tar.gz

# ts-rs generated TypeScript bindings
bindings/

# Generated BAML TypeScript client (not used by our runtime, but may be generated by users)
baml_client/

# Compiled JavaScript output (in agent directories)
dist/

# Environment files (API keys, etc.)
.env
.env.local
.env.*.local

# IDE
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~

# Provenance and config databases (SurrealKV directories)
provenance.db
provenance.db-shm
provenance.db-wal
config.db
crates/baml-agent-runner/.repository/
crates/baml-agent-runner/.runner-state/

# Repo-root local runner dev and debug artifacts (do not commit)
/.repository/
/.runner-state/
# E2E / integration SurrealKV trees (LOCK, manifest/, wal/); never commit
/provenance-e2e.db/
/.repository-e2e/
/.runner-state-e2e/
/.verify-stack/
/provenance_db
/provenance_db-shm
/provenance_db-wal

# Fastembed model cache (downloaded ONNX models, ~130 MB)
.fastembed_cache/
# HF-style fetch sidecars — not committed (tensors under blobs/ use Git LFS)
models/fastembed/**/blobs/*.lock
models/fastembed/**/blobs/*.part

# task-daemon Slack source dump — local-only, carries workspace tokens
source-slack.json

# Nix
.direnv/
result
.pi/

# insta pending snapshots (never commit)
*.snap.new

# Karakara Labs Team Related
.ravs/
