assertion_line: 78
expression: "format!(\"== graph projection ==\\n{}\\n== rendered BAML ==\\n{}\",\nproject_graph(&graph), rendered.trim_end())"
---
== graph projection ==
Address (0) fp=object[city:true:string,lines:true:arr[string],ap:AllowedAny]
  field city: string required=true
  field lines: string[] required=true

NestedRequest (1) fp=object[address:true:ref:0,kind:true:ref:3,ap:AllowedAny]
  field address: Address required=true
  field kind: RequestKind required=true
  deps [Address, RequestKind]

RepresentativeToolInput (2) fp=object[request:true:ref:1,required_nullable:true:string,optional_note:false:string,labels:true:map[string],addresses:true:arr[ref:0],content:false:vec_or_one[union[ref:4]],opaque_payload:true:json,ap:AllowedAny]
  field request: NestedRequest required=true
  field required_nullable: string required=true
  field optional_note: string required=false
  field labels: map<string, string> required=true
  field addresses: Address[] required=true
  field content: (RepresentativeToolInputContent | RepresentativeToolInputContent[]) required=false
  field opaque_payload: json required=true
  deps [Address, NestedRequest, RepresentativeToolInputContent]

RepresentativeToolInputContent (4) fp=object[kind:true:string,text:true:string,ap:AllowedAny]
  field kind: string required=true
  field text: string required=true

RequestKind (3) fp=enum[String("create"),String("update")]
  variant Create = String("create")
  variant Update = String("update")


== rendered BAML ==
class Address {
  city string
  lines string[]
  @@dynamic
}

class NestedRequest {
  address Address
  kind RequestKind
  @@dynamic
}

class RepresentativeToolInputContent {
  kind string
  text string
  @@dynamic
}

class RepresentativeToolInput {
  request NestedRequest
  required_nullable string
  optional_note string?
  labels map<string, string>
  addresses Address[]
  content (RepresentativeToolInputContent | RepresentativeToolInputContent[])?
  opaque_payload OpaqueJson @description("Opaque JSON transport value. Direct host callers may send raw JSON; generated BAML callers should use the OpaqueJson wrapper.")
  @@dynamic
}

enum RequestKind {
  Create
    @alias("create")
  Update
    @alias("update")
}
