== rendered BAML ==
class RepresentativeToolInputContentAlt0 {
  kind string
  text string
  @@dynamic
}

class RepresentativeToolInputContentAlt1 {
  kind string
  url string
  @@dynamic
}

class RepresentativeToolInputContentAlt2 {
  kind string
  media_type string
  data string
  @@dynamic
}

class RepresentativeToolInput {
  request NestedRequest
  required_nullable string | null
  optional_note string?
  labels map<string, string>
  addresses Address[]
  content (RepresentativeToolInputContentAlt0 | RepresentativeToolInputContentAlt1 | RepresentativeToolInputContentAlt2 | (RepresentativeToolInputContentAlt0 | RepresentativeToolInputContentAlt1 | RepresentativeToolInputContentAlt2)[])?
  opaque_payload OpaqueJson @description("Opaque JSON transport value. Direct host callers may send raw JSON; generated BAML callers should use the OpaqueJson wrapper.")
  @@dynamic
}

class Address {
  city string
  lines string[]
  @@dynamic
}

class NestedRequest {
  address Address
  kind RequestKind
  @@dynamic
}

enum RequestKind {
  Create
    @alias("create")
  Update
    @alias("update")
}
